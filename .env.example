DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_PORT=5432

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Kroger Developer public API (developer.kroger.com) - used by app/api for
# live product/price lookups and nearby-store search
KROGER_CLIENT_ID=your_kroger_client_id
KROGER_CLIENT_SECRET=your_kroger_client_secret

# Resend (resend.com) - sends price-alert emails from /cron/check_alerts
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=GroceryScan <onboarding@resend.dev>

# Optional: set this AND add the same value in Vercel's Cron settings so
# /cron/check_alerts only responds to Vercel's own scheduled invocation
CRON_SECRET=some_random_string
